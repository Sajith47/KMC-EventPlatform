@model KMC.WebClient.Models.DashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
    var activeTab = ViewBag.ActiveTab as string ?? "events";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>My Dashboard</h2>
            <p class="text-muted mb-0">Welcome back, <strong>@Model.FullName</strong> (@Model.Role Account)</p>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-person-badge me-1"></i> @Model.Role</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="bi bi-calendar-event fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@Model.RegisteredEvents.Count</h3>
                        <span class="text-muted small">Joined Events</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success text-white rounded-circle p-3 me-3">
                        <i class="bi bi-envelope-check fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-truncate" style="max-width: 200px;">@Model.Email</h6>
                        <span class="text-muted small">Registered Email</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-info text-white rounded-circle p-3 me-3">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">Active</h5>
                        <span class="text-muted small">Account Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(activeTab == "events" ? "active fw-bold" : "")" id="events-tab" href="@Url.Action("Index", "Dashboard", new { tab = "events" })">
                <i class="bi bi-calendar2-check me-2"></i>Joined Events (@Model.RegisteredEvents.Count)
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(activeTab == "profile" ? "active fw-bold" : "")" id="profile-tab" href="@Url.Action("Index", "Dashboard", new { tab = "profile" })">
                <i class="bi bi-gear me-2"></i>Manage Account
            </a>
        </li>
    </ul>

    <div class="tab-content" id="dashboardTabsContent">
        <!-- Joined Events Tab -->
        @if (activeTab == "events")
        {
            <div class="tab-pane fade show active" id="events" role="tabpanel">
                @if (Model.RegisteredEvents.Count == 0)
                {
                    <div class="text-center py-5 border rounded-3 bg-white shadow-sm">
                        <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">You haven't joined any events yet.</h5>
                        <p class="text-muted">Browse public city events in Kandy and register today!</p>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">
                            <i class="bi bi-search me-1"></i> Explore Events
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Event Title</th>
                                    <th>Registered Date</th>
                                    <th>Contact Phone</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reg in Model.RegisteredEvents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@reg.EventTitle</div>
                                            <small class="text-muted">Registration ID: #@reg.Id</small>
                                        </td>
                                        <td>
                                            <i class="bi bi-clock me-1 text-primary"></i>
                                            @reg.RegisteredAt.ToString("MMM dd, yyyy - hh:mm tt")
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(reg.ParticipantPhone) ? "N/A" : reg.ParticipantPhone)
                                        </td>
                                        <td class="text-end">
                                            <a href="@Url.Action("Details", "Home", new { id = reg.EventId })" class="btn btn-sm btn-outline-primary me-2">
                                                <i class="bi bi-eye me-1"></i> View Event
                                            </a>
                                            <form method="post" action="@Url.Action("CancelRegistration", "Dashboard")" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel your registration for this event?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@reg.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i> Cancel
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <!-- Manage Account Tab -->
        @if (activeTab == "profile")
        {
            <div class="tab-pane fade show active" id="profile" role="tabpanel">
                <div class="row g-4">
                    <!-- Update Profile Form -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white border-bottom py-3">
                                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Profile Details</h5>
                            </div>
                            <div class="card-body p-4">
                                <form method="post" action="@Url.Action("UpdateProfile", "Dashboard")">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Email Address</label>
                                        <input type="email" class="form-control" value="@Model.Email" readonly disabled />
                                        <small class="text-muted">Email address cannot be changed.</small>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ProfileModel.FullName" class="form-label font-weight-bold">Full Name</label>
                                        <input asp-for="ProfileModel.FullName" class="form-control" placeholder="Enter full name" />
                                        <span asp-validation-for="ProfileModel.FullName" class="text-danger small"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-save me-1"></i> Update Profile
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Change Password Form -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white border-bottom py-3">
                                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-shield-lock me-2 text-primary"></i>Security & Password</h5>
                            </div>
                            <div class="card-body p-4">
                                <form method="post" action="@Url.Action("ChangePassword", "Dashboard")">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label asp-for="PasswordModel.CurrentPassword" class="form-label font-weight-bold">Current Password</label>
                                        <input asp-for="PasswordModel.CurrentPassword" class="form-control" placeholder="••••••••" />
                                        <span asp-validation-for="PasswordModel.CurrentPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PasswordModel.NewPassword" class="form-label font-weight-bold">New Password</label>
                                        <input asp-for="PasswordModel.NewPassword" class="form-control" placeholder="••••••••" />
                                        <span asp-validation-for="PasswordModel.NewPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PasswordModel.ConfirmNewPassword" class="form-label font-weight-bold">Confirm New Password</label>
                                        <input asp-for="PasswordModel.ConfirmNewPassword" class="form-control" placeholder="••••••••" />
                                        <span asp-validation-for="PasswordModel.ConfirmNewPassword" class="text-danger small"></span>
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="bi bi-key me-1"></i> Change Password
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
