@* Shared Layout for KMC Event Platform *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KMC Event Platform</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-subtle">
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded-3 px-2 py-1 fs-6"><i class="bi bi-calendar-event-fill"></i></span>
                    <span>KMC Events</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2" asp-controller="Home" asp-action="Search"><i class="bi bi-search me-1"></i> Find Events</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-2 fw-medium text-primary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-person-workspace me-1"></i> My Dashboard</a>
                            </li>
                        }
                        @if (User.IsInRole("Organizer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-2 fw-medium text-primary" asp-controller="Events" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Organizer Dashboard</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-6"></i>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>My Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index" asp-route-tab="profile"><i class="bi bi-gear me-2"></i>Manage Account</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (User.IsInRole("Organizer"))
                                    {
                                        <li><a class="dropdown-menu-item dropdown-item" asp-controller="Events" asp-action="Index"><i class="bi bi-journal-plus me-2"></i>Manage My Events</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                            <button type="submit" class="btn btn-danger btn-sm w-100 rounded-2"><i class="bi bi-box-arrow-right me-1"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-ghost text-secondary btn-sm px-3 rounded-pill fw-medium" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-primary btn-sm px-3 rounded-pill fw-medium shadow-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 px-lg-5 my-4 flex-grow-1">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["Message"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-white border-top py-4 mt-auto">
        <div class="container-fluid px-4 px-lg-5 text-center text-muted small">
            <div>
                <span class="fw-semibold text-dark">Kandy Municipal Council</span> &copy; @DateTime.Now.Year Event Platform
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
