@model List<EventDto>
@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-speedometer2 text-primary me-2"></i>Organizer Dashboard</h2>
        <p class="text-muted small m-0">Manage events created by your organizer account</p>
    </div>
    <a class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm" asp-action="Create">
        <i class="bi bi-plus-circle me-1"></i> Create New Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="text-muted mb-3"><i class="bi bi-journal-plus fs-1"></i></div>
        <h5 class="fw-semibold text-secondary">No events created yet</h5>
        <p class="text-muted small mb-4">Start organizing events for the Kandy Municipal Council platform today.</p>
        <div>
            <a class="btn btn-primary rounded-pill px-4 btn-sm" asp-action="Create">+ Create First Event</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-4">Event Details</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Date & Time</th>
                        <th class="py-3">Venue</th>
                        <th class="py-3 text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="py-3 px-4">
                                <div class="fw-semibold text-dark">@ev.Title</div>
                                <div class="text-muted small">ID: #@ev.Id @(ev.Capacity > 0 ? $"· Cap: {ev.Capacity}" : "")</div>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-event-type">@ev.EventType</span>
                            </td>
                            <td class="py-3 text-secondary small">
                                <i class="bi bi-calendar3 me-1 text-primary"></i> @ev.EventDate.ToString("dd MMM yyyy, h:mm tt")
                            </td>
                            <td class="py-3 text-secondary small">
                                <i class="bi bi-geo-alt me-1 text-danger"></i> @ev.Venue
                            </td>
                            <td class="py-3 text-end px-4">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-info rounded-start" asp-action="Registrations" asp-route-id="@ev.Id" title="View Registrations">
                                        <i class="bi bi-people me-1"></i> Registrants
                                    </a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@ev.Id" title="Edit Event">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@ev.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger rounded-end" title="Delete Event">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
