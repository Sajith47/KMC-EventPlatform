@model List<EventDto>
@{
    ViewData["Title"] = "Home - KMC Event Platform";
}

<!-- Hero Section -->
<div class="hero-banner p-4 p-md-5 mb-5 shadow-sm">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-2 mb-3 fw-normal">
                <i class="bi bi-geo-alt-fill text-warning me-1"></i> Kandy Municipal Council
            </span>
            <h1 class="display-5 fw-bold mb-3">Discover & Join Events Across Kandy</h1>
            <p class="lead text-white-50 mb-4 me-lg-4">
                The central hub for official city events, cultural gatherings, and community activities. Discover upcoming events or host your own.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-warning btn-lg px-4 rounded-pill fw-semibold shadow-sm text-dark" asp-controller="Home" asp-action="Search">
                    <i class="bi bi-search me-1"></i> Browse All Events
                </a>
                @if (User.IsInRole("Organizer"))
                {
                    <a class="btn btn-outline-light btn-lg px-4 rounded-pill fw-semibold" asp-controller="Events" asp-action="Create">
                        <i class="bi bi-plus-circle me-1"></i> Create Event
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Events Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0">Upcoming Events</h3>
        <p class="text-muted small m-0">Featured events happening in the city</p>
    </div>
    <a class="btn btn-link text-primary fw-medium text-decoration-none p-0" asp-controller="Home" asp-action="Search">
        View all events <i class="bi bi-arrow-right"></i>
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="mb-3 text-muted">
            <i class="bi bi-calendar-x fs-1"></i>
        </div>
        <h5 class="fw-semibold text-secondary">No upcoming events found</h5>
        <p class="text-muted small">Check back later or try searching for past events.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="card h-100 event-card shadow-sm border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-event-type">
                                @ev.EventType
                            </span>
                            @if (ev.Capacity > 0)
                            {
                                <span class="badge bg-light text-secondary border rounded-pill">
                                    <i class="bi bi-people me-1"></i> Cap: @ev.Capacity
                                </span>
                            }
                        </div>
                        <h5 class="card-title text-dark mb-2">@ev.Title</h5>
                        <p class="card-text text-secondary small mb-4 flex-grow-1">
                            @(ev.Description.Length > 110 ? ev.Description.Substring(0, 110) + "..." : ev.Description)
                        </p>
                        <div class="border-top pt-3 mt-auto">
                            <div class="d-flex align-items-center text-muted small mb-2">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>
                                <span>@ev.EventDate.ToString("ddd, dd MMM yyyy @ h:mm tt")</span>
                            </div>
                            <div class="d-flex align-items-center text-muted small mb-3">
                                <i class="bi bi-geo-alt me-2 text-danger"></i>
                                <span>@ev.Venue</span>
                            </div>
                            <a class="btn btn-outline-primary w-100 rounded-pill fw-medium btn-sm" asp-controller="Home" asp-action="Details" asp-route-id="@ev.Id">
                                View Details <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
