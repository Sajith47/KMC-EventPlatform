@model SearchViewModel
@{
    ViewData["Title"] = "Find Events";
}

<div class="mb-4">
    <h2 class="fw-bold m-0">Find Events in Kandy</h2>
    <p class="text-muted">Filter by keyword, event category, or date to explore events</p>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form method="get" asp-controller="Home" asp-action="Search" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Search Keyword</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" class="form-control border-start-0" placeholder="Event title, description, venue..." value="@Model.Keyword" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Event Category</label>
                <select name="eventType" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var type in Model.AvailableTypes)
                    {
                        <option value="@type" selected="@(type.Equals(Model.EventType, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Date</label>
                <input type="date" name="date" class="form-control" value="@Model.Date" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-2 fw-medium py-2"><i class="bi bi-funnel me-1"></i> Filter</button>
                @if (!string.IsNullOrEmpty(Model.Keyword) || !string.IsNullOrEmpty(Model.EventType) || !string.IsNullOrEmpty(Model.Date))
                {
                    <a asp-action="Search" class="btn btn-outline-secondary py-2 rounded-2" title="Reset Filters"><i class="bi bi-x-circle"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Search Results -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">Showing <strong>@Model.Results.Count</strong> event(s)</span>
</div>

@if (!Model.Results.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="text-muted mb-2"><i class="bi bi-search fs-1"></i></div>
        <h5 class="fw-semibold text-secondary">No events matching your filters</h5>
        <p class="text-muted small">Try adjusting your category, keyword, or date filter.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var ev in Model.Results)
        {
            <div class="col">
                <div class="card h-100 event-card shadow-sm border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-event-type">
                                @ev.EventType
                            </span>
                        </div>
                        <h5 class="card-title text-dark mb-2">@ev.Title</h5>
                        <p class="card-text text-secondary small mb-4 flex-grow-1">
                            @(ev.Description.Length > 110 ? ev.Description.Substring(0, 110) + "..." : ev.Description)
                        </p>
                        <div class="border-top pt-3 mt-auto">
                            <div class="d-flex align-items-center text-muted small mb-2">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>
                                <span>@ev.EventDate.ToString("ddd, dd MMM yyyy @ h:mm tt")</span>
                            </div>
                            <div class="d-flex align-items-center text-muted small mb-3">
                                <i class="bi bi-geo-alt me-2 text-danger"></i>
                                <span>@ev.Venue</span>
                            </div>
                            <a class="btn btn-outline-primary w-100 rounded-pill fw-medium btn-sm" asp-controller="Home" asp-action="Details" asp-route-id="@ev.Id">
                                View Details <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
