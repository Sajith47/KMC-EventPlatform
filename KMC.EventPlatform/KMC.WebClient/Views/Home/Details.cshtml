@model EventDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle badge-event-type">
                    @Model.EventType
                </span>
                <span class="text-muted small"><i class="bi bi-person-fill text-secondary"></i> Organised by <strong>@Model.OrganizerName</strong></span>
            </div>
            
            <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>
            
            <div class="row g-3 py-3 border-top border-bottom my-3">
                <div class="col-sm-6 d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-3 fs-4">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Date & Time</div>
                        <div class="fw-semibold">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</div>
                        <div class="text-secondary small">@Model.EventDate.ToString("h:mm tt")</div>
                    </div>
                </div>
                <div class="col-sm-6 d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger p-3 rounded-3 fs-4">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Venue / Location</div>
                        <div class="fw-semibold">@Model.Venue</div>
                        <div class="text-secondary small">Kandy, Sri Lanka</div>
                    </div>
                </div>
            </div>

            <h5 class="fw-semibold mt-3 mb-2">About This Event</h5>
            <p class="text-secondary lh-lg" style="white-space: pre-line;">@Model.Description</p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 90px;">
            <h5 class="fw-bold mb-3">Join This Event</h5>
            <p class="text-muted small mb-4">Registration is open to the public. Secure your spot now.</p>
            
            @if (Model.Capacity > 0)
            {
                <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded-3 mb-4 border">
                    <span class="text-secondary small"><i class="bi bi-people me-1"></i> Max Capacity</span>
                    <span class="fw-bold text-dark">@Model.Capacity Attendees</span>
                </div>
            }

            <a class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm mb-3" asp-controller="Home" asp-action="Register" asp-route-id="@Model.Id">
                <i class="bi bi-pencil-square me-1"></i> Register Now
            </a>
            
            <a class="btn btn-outline-secondary w-100 rounded-pill btn-sm" asp-controller="Home" asp-action="Search">
                <i class="bi bi-arrow-left me-1"></i> Back to Events
            </a>
        </div>
    </div>
</div>
